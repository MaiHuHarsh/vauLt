        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    START([User action]) --&gt; TYPE{Action type}\n\n    %% Upload flow\n    TYPE --&gt;|Upload document| U1[Check permission on case]\n    U1 --&gt; U2[Hash original file - SHA256]\n    U2 --&gt; U3[Encrypt file - AES256GCM]\n    U3 --&gt; U4[Store ciphertext in MinIO]\n    U4 --&gt; U5[Save DOCUMENT_VERSION + FILE_OBJECT]\n    U5 --&gt; U6[Run OCR - extract text, AI tags]\n    U6 --&gt; U7[Write audit log - chained hash]\n    U7 --&gt; DONE1([Upload complete])\n\n    %% Retrieve flow\n    TYPE --&gt;|View/Download document| R1{Access allowed?}\n    R1 --&gt;|No| R1X[Log access_denied]\n    R1X --&gt; DONE2([Blocked])\n    R1 --&gt;|Yes| R2[Fetch ciphertext from MinIO]\n    R2 --&gt; R3[Decrypt with stored key]\n    R3 --&gt; R4{Hash matches file_hash?}\n    R4 --&gt;|No| R4X[Flag tampered, block delivery]\n    R4X --&gt; DONE3([Blocked - tamper alert])\n    R4 --&gt;|Yes| R5[Serve file to user]\n    R5 --&gt; R6[Write audit log]\n    R6 --&gt; DONE4([Document delivered])\n\n    %% Evidence transfer flow\n    TYPE --&gt;|Transfer evidence| E1[Create EVIDENCE_TRANSFER row]\n    E1 --&gt; E2[Both parties sign - DIGITAL_SIGNATURE]\n    E2 --&gt; E3{Receiver accepts?}\n    E3 --&gt;|No| E3X[Mark transfer rejected]\n    E3X --&gt; DONE5([Transfer rejected, logged])\n    E3 --&gt;|Yes| E4[Update EVIDENCE.current_holder]\n    E4 --&gt; E5[Write audit log]\n    E5 --&gt; DONE6([Custody transferred])\n\n    %% Access control flow\n    TYPE --&gt;|Grant/revoke access| A1[Admin selects user + case/doc]\n    A1 --&gt; A2[Insert/update ACCESS_CONTROL row]\n    A2 --&gt; A3[Set expires_at if temporary]\n    A3 --&gt; A4[Write audit log]\n    A4 --&gt; DONE7([Access updated])\n\n    %% Verify integrity flow\n    TYPE --&gt;|Verify integrity| V1[Walk AUDIT_LOGS chain]\n    V1 --&gt; V2{prev_hash matches&lt;br/&gt;recomputed hash?}\n    V2 --&gt;|No| V2X[Report break point - user, timestamp]\n    V2X --&gt; DONE8([Tamper detected])\n    V2 --&gt;|Yes| V3[Chain intact confirmation]\n    V3 --&gt; DONE9([Integrity verified])\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zI5YtIJMguwDAWtQioNZ-1">
