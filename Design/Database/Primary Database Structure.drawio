        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    ORGANIZATIONS {\n        uuid id PK\n        varchar name\n        varchar code UK\n    }\n\n    USERS {\n        uuid id PK\n        uuid org_id FK\n        varchar name\n        varchar email UK\n        text password_hash\n        enum role\n        enum status\n    }\n\n    CASES {\n        uuid id PK\n        uuid org_id FK\n        varchar case_number UK\n        varchar title\n        enum status\n        enum sensitivity_level\n        timestamp retention_until\n        boolean legal_hold\n        uuid created_by FK\n        timestamp created_at\n    }\n\n    CASE_COLLABORATORS {\n        uuid id PK\n        uuid case_id FK\n        uuid user_id FK\n        varchar dept\n        uuid added_by FK\n        timestamp added_at\n        timestamp removed_at\n    }\n\n    DOCUMENTS {\n        uuid id PK\n        uuid case_id FK \&quot;nullable\&quot;\n        varchar doc_type\n        varchar title\n        enum classification\n        uuid current_version_id FK\n        tsvector extracted_text\n        jsonb ai_tags\n        varchar ai_classification\n        uuid created_by FK\n        timestamp created_at\n    }\n\n    DOCUMENT_VERSIONS {\n        uuid id PK\n        uuid document_id FK\n        int version_no\n        uuid file_object_id FK\n        varchar file_hash\n        uuid uploaded_by FK\n        boolean is_original\n        enum ocr_status\n        timestamp created_at\n    }\n\n    FILE_OBJECTS {\n        uuid id PK\n        varchar bucket\n        text object_key UK\n        boolean encrypted\n        uuid encryption_key_id FK\n        bigint size\n        varchar checksum\n        timestamp created_at\n    }\n\n    ENCRYPTION_KEYS {\n        uuid id PK\n        text key_ref\n        varchar algorithm\n        enum status\n        timestamp created_at\n        timestamp rotated_at\n    }\n\n    EVIDENCE {\n        uuid id PK\n        uuid case_id FK\n        varchar evidence_number UK\n        varchar type\n        uuid collected_by FK\n        uuid current_holder FK\n        enum status\n    }\n\n    EVIDENCE_TRANSFERS {\n        uuid id PK\n        uuid evidence_id FK\n        uuid from_user FK\n        uuid to_user FK\n        text reason\n        uuid signature_id FK\n        enum status\n        timestamp timestamp\n    }\n\n    DIGITAL_SIGNATURES {\n        uuid id PK\n        uuid signer_id FK\n        varchar target_type\n        uuid target_id\n        varchar algorithm\n        text signature_value\n        timestamp signed_at\n    }\n\n    ACCESS_CONTROL {\n        uuid id PK\n        uuid user_id FK\n        uuid case_id FK \&quot;nullable\&quot;\n        uuid document_id FK \&quot;nullable\&quot;\n        varchar permission\n        uuid granted_by FK\n        timestamp granted_at\n        timestamp expires_at\n        timestamp revoked_at\n    }\n\n    AUDIT_LOGS {\n        uuid id PK\n        uuid user_id FK\n        varchar action\n        varchar resource_type\n        uuid resource_id\n        timestamp timestamp\n        varchar prev_hash\n        varchar log_hash\n    }\n\n    ORGANIZATIONS ||--o{ USERS : employs\n    ORGANIZATIONS ||--o{ CASES : owns\n\n    USERS ||--o{ CASES : creates\n    CASES ||--o{ CASE_COLLABORATORS : has\n    USERS ||--o{ CASE_COLLABORATORS : joins\n\n    CASES ||--o{ DOCUMENTS : contains\n    USERS ||--o{ DOCUMENTS : creates\n    DOCUMENTS ||--o{ DOCUMENT_VERSIONS : has\n    USERS ||--o{ DOCUMENT_VERSIONS : uploads\n    DOCUMENT_VERSIONS ||--|| FILE_OBJECTS : stored_as\n    ENCRYPTION_KEYS ||--o{ FILE_OBJECTS : encrypts\n\n    CASES ||--o{ EVIDENCE : contains\n    USERS ||--o{ EVIDENCE : collects\n    EVIDENCE ||--o{ EVIDENCE_TRANSFERS : transferred\n    USERS ||--o{ EVIDENCE_TRANSFERS : from_to\n\n    USERS ||--o{ DIGITAL_SIGNATURES : signs\n    DIGITAL_SIGNATURES ||--o{ EVIDENCE_TRANSFERS : signs\n\n    USERS ||--o{ ACCESS_CONTROL : granted\n    CASES ||--o{ ACCESS_CONTROL : scoped\n    DOCUMENTS ||--o{ ACCESS_CONTROL : scoped\n\n    USERS ||--o{ AUDIT_LOGS : performs&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r6HszuBGaxXT41Phxc6o-1024">
